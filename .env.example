# 快速启动必填项：复制为 .env 后填写真实 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=postgresql://127.0.0.1:5432/haitian_sourcing_demo

# 高级覆盖项：本地演示已有默认值，仅在确有需要时取消注释。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_MS=20000
# SOURCING_TOOL_DELAY_MS=1200
# EVALUATION_STEP_DELAY_MS=1000

# 非默认数据库名称的安全确认开关，只能用于专用演示库。
# CONFIRM_DEMO_DATABASE=yes

# 生产部署必须替换并显式配置；本地演示使用脚本内置默认值。
# QUOTE_ENCRYPTION_KEY=<32 字节随机密钥的 Base64 编码>
# QUOTE_KEY_VERSION=demo-v1
# DEMO_SERVICE_TOKEN=<内部服务调用凭证>
# DEMO_SESSION_SECRET=<至少 32 字符的会话签名密钥>
# DEMO_RESET_ENABLED=false
