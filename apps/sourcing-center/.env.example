# 开发环境可省略 DATABASE_URL，生产环境必须显式配置。
DATABASE_URL=postgresql://127.0.0.1:5432/haitian_sourcing_demo

# 32 字节随机密钥的 Base64 编码；生产环境必须替换并显式配置。
QUOTE_ENCRYPTION_KEY=aGFpdGlhbi1kZW1vLXNlYWxlZC1rZXktMzItYnl0ZSE=
QUOTE_KEY_VERSION=demo-v1

# 仅供内部、外部供应商 BFF 服务端调用核心 API，不能暴露到浏览器。
DEMO_SERVICE_TOKEN=haitian-demo-service-local
DEMO_RESET_ENABLED=true

# 现场执行新寻源和新评估时必须配置。未配置时接口明确失败，不生成伪 Agent 结果。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=20000
SOURCING_TOOL_DELAY_MS=1200
EVALUATION_STEP_DELAY_MS=1000
